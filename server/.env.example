# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gunlite?retryWrites=true&w=majority

# JWT Authentication (use a strong random 64-char secret in production)
JWT_SECRET=replace_with_a_strong_random_jwt_secret
JWT_EXPIRES_IN=7d

# Optional CSRF signing secret (defaults to JWT_SECRET) and cookie SameSite policy
# Use "lax" when using a same-origin Vercel /api proxy; "none" for direct cross-domain HTTPS
# CSRF_SECRET=replace_with_another_random_secret
# COOKIE_SAME_SITE=none

# Allowed Frontend Origins (comma-separated for CORS with credentials)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Cloudinary Credentials (never expose API_SECRET to frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Setup (used by `npm run create-admin`; omit ADMIN_PASSWORD to enter via hidden prompt)
ADMIN_NAME=GunLite Administrator
ADMIN_EMAIL=admin@gunlite.in
ADMIN_PASSWORD=

# Video Upload Configuration (matches Cloudinary plan limit; explicit bound in MB, never unlimited)
MAX_VIDEO_SIZE_MB=100
