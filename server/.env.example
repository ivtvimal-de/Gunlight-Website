# Server Configuration
PORT=5000
NODE_ENV=development

# Set to true for zero-setup local JSON persistence (server/data/), false for MongoDB / Atlas
USE_LOCAL_STORE=false

# MongoDB Connection (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gunlite?retryWrites=true&w=majority

# JWT Authentication (use a strong random 64-char secret in production)
JWT_SECRET=replace_with_a_strong_random_jwt_secret
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated for CORS with credentials)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://gunlight-website.vercel.app

# Cloudinary Credentials (never expose API_SECRET to frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Seed Credentials (used only by `npm run seed`)
ADMIN_NAME=GunLite Administrator
ADMIN_EMAIL=admin@gunlite.in
ADMIN_PASSWORD=ChangeThisStrongPassword123!
